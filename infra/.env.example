# Production settings for the homelab stack (infra/docker-compose.prod.yml + infra/docker-compose.homelab.yml
# + infra/docker-compose.backup.yml).
# Copy to infra/.env (git-ignored, chmod 600) and replace every `change-me` value; `make check-env`
# refuses to deploy while one is left. Never commit the real file.
# Development needs none of this: `make dev` uses the fixed local defaults in apps/api/Makefile and
# infra/docker-compose.yml. The only dev knob is POSTGRES_HOST_PORT (default 5442; 5432 is often taken
# by another local Postgres), exported in the shell, never in this file.
#
# Generate secrets with: openssl rand -base64 32
# Passwords that also appear inside a URL below must stay URL-safe (letters, digits, - and _), e.g.
#   openssl rand -hex 24

# --- Edge -------------------------------------------------------------------------------------
# Apex zone. Tenants live on <slug>.DOMAIN, the platform admin on admin.DOMAIN.
DOMAIN=sidecup.app
# Apex URL; tenant and admin URLs are derived from it.
PUBLIC_BASE_URL=https://sidecup.app
# Reverse proxies (Traefik) allowed to name the client address, comma separated CIDRs or IPs.
# Required in production: the API refuses to start without it. The client IP (rate limits, audit,
# sessions) is read only from CF-Connecting-IP, and only when the TCP peer is inside these ranges;
# X-Forwarded-For and X-Real-IP are never used. Every other peer is taken at its TCP address.
# Prefer the Traefik container's own address (x.x.x.x/32, from
# `docker network inspect homelab`) when it is static; the whole `homelab` subnet also trusts the
# other stacks on that network, which could then forge CF-Connecting-IP.
TRUSTED_PROXY_CIDRS=172.21.0.0/16
# Hostname labels other stacks already use on DOMAIN; signup refuses them as tenant slugs (comma separated).
RESERVED_SLUGS=tiendouong,tiendouong-api

# --- Application ------------------------------------------------------------------------------
# production refuses `tally seed dev` and `tally seed load`; they run only with development or test.
APP_ENV=production
APP_TZ=Asia/Ho_Chi_Minh
# debug | info | warn | error
LOG_LEVEL=info
# Documented for completeness: the production compose pins it to false. Migrations run only through
# `make prod-migrate`, which takes a backup first.
MIGRATE_ON_START=false
# Receives the first platform-admin invitation.
PLATFORM_ADMIN_BOOTSTRAP_EMAIL=change-me@example.com
# Optional image tag for tally-api / tally-web (defaults to "dev").
# VERSION=2026.10.16

# --- Secrets ----------------------------------------------------------------------------------
SESSION_HASH_KEY=change-me-session-hash-key
CSRF_KEY=change-me-csrf-key
# Encrypts stored credentials; rotating it requires re-encrypting the data.
APP_ENCRYPTION_KEY=change-me-app-encryption-key

# --- Database ---------------------------------------------------------------------------------
# The roles are created from these passwords only when the data volume is first initialised
# (infra/postgres/init/01-roles.sh); changing them later needs ALTER ROLE as well.
POSTGRES_DB=tally
POSTGRES_SUPERUSER_PASSWORD=change-me-superuser-password
TALLY_OWNER_PASSWORD=change-me-owner-password
TALLY_APP_PASSWORD=change-me-app-password
TALLY_READONLY_PASSWORD=change-me-readonly-password
# API and worker: tally_app (no DDL). Host is the project-network alias tally-postgres.
DATABASE_URL=postgres://tally_app:change-me-app-password@tally-postgres:5432/tally?sslmode=disable
# Migrations only (one-shot `migrate` service): tally_owner owns schema `tally`.
MIGRATE_DATABASE_URL=postgres://tally_owner:change-me-owner-password@tally-postgres:5432/tally?sslmode=disable

# --- Mail -------------------------------------------------------------------------------------
SMTP_HOST=change-me.smtp.example.com
SMTP_PORT=587
SMTP_USER=change-me-smtp-user
SMTP_PASSWORD=change-me-smtp-password
MAIL_FROM=Tally <no-reply@sidecup.app>

# --- Object storage (S3 compatible, e.g. Cloudflare R2) -----------------------------------------
# Also allowed as an image source in the CSP (img-src).
OBJECT_STORE_ENDPOINT=https://change-me.r2.cloudflarestorage.com
OBJECT_STORE_REGION=auto
OBJECT_STORE_BUCKET=tally-prod
OBJECT_STORE_ACCESS_KEY=change-me-access-key
OBJECT_STORE_SECRET_KEY=change-me-secret-key

# --- Backups (wal-g sidecar, infra/docker-compose.backup.yml) ----------------------------------
# WAL archiving and nightly base backups go to a bucket of their own with a token scoped to it
# (object read/write), never the app's object store above. Keep a copy of these values, the
# libsodium key above all, outside the homelab: a restore after losing the host needs them.
WALG_S3_PREFIX=s3://change-me-tally-backups/prod
WALG_S3_ENDPOINT=https://change-me.r2.cloudflarestorage.com
WALG_S3_REGION=auto
WALG_S3_ACCESS_KEY=change-me-backup-access-key
WALG_S3_SECRET_KEY=change-me-backup-secret-key
# Client-side encryption of every backup and WAL file: openssl rand -base64 32. Losing it loses
# every backup; rotating it needs a new base backup (older backups keep needing the old key).
WALG_LIBSODIUM_KEY=change-me-backup-encryption-key
# Daily base backup at this time (APP_TZ) and the number of full backups kept with their WAL.
BACKUP_BASE_TIME=02:30
BACKUP_RETAIN_FULL=7
